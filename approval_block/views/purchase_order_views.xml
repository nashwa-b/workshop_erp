<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_view_form" model="ir.ui.view">
        <field name="name">purchase.order.view.form.inherit.approval.block</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                    <field name="limit_id"/>
<!--                    <field name="products" widget="many2many_tags"/>-->
            </xpath>
        </field>
    </record>

     <record id="approval_block_action" model="ir.actions.act_window">
            <field name="name">Approval Block</field>
            <field name="res_model">approval.block</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click here to create your first Approval Block
                </p>
            </field>
        </record>
   <menuitem id="approval_block_menu" name="Approval Blocks"
             parent="purchase.menu_purchase_config" sequence="11" action="approval_block.approval_block_action"/>
</odoo>
