<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_preferences" model="ir.ui.view">
        <field name="name">hr.employee.view.form.preference.inherit.</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="loan_not_allowed">Loan not allowed</field>
            </xpath>
        </field>
    </record>
</odoo>