<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_requisition_user" model="res.groups">
        <field name="name">Requisition User</field>
        <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="group_requisition_department_manager" model="res.groups">
        <field name="name">Requisition Department Manager</field>
        <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('purchase.group_purchase_user'))]"/>

    </record>

    <record id="group_requisition_head" model="res.groups">
        <field name="name">Requisition Head</field>
        <field name="privilege_id" ref="purchase.res_groups_privilege_purchase"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('purchase.group_purchase_user'))]"/>
    </record>


</odoo>