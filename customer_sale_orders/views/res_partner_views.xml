<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.sale.order</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Sale Orders">
                    <field name="sale_order_ids">
<!--                        <list editable="bottom">-->
<!--                            <field name="name"/>-->
<!--                            <field name="licence_plate"/>-->
<!--                            <field name="vin"/>-->
<!--                            <field name="odometer"/>-->
<!--                        </list>-->
                    </field>
                </page>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
<!--                <button>-->
                <button name="action_view_products"
                        type="object"
                        class="oe_stat_button">
                    <field name="product_count" widget="statinfo" string="Products"/>
                </button>
<!--                <button name="action_view_job_order"-->
<!--                        type="object"-->
<!--                        class="oe_stat_button" icon="fa-wrench">-->
<!--                    <field name="job_order_count" widget="statinfo" string="Job Orders"/>-->
<!--                </button>-->
            </xpath>
        </field>
    </record>



</odoo>

