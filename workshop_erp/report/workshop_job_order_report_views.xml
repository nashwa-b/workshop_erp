<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_student_report" model="report.paperformat">
    <field name="name">Custom Paperformat for the Student report</field>
    <field name="default" eval="False"/>
    <field name="disable_shrinking" eval="True"/>
    <field name="format">A3</field>
    <field name="page_height">0</field>
    <field name="page_width">0</field>
    <field name="orientation">Landscape</field>
    <field name="margin_top">8</field>
    <field name="header_line" eval="False" />
    <field name="header_spacing">0</field>
    <field name="dpi">90</field>
</record>


<record id="action_report_joborder" model="ir.actions.report">
        <field name="name">job order pdf</field>
        <field name="model">workshop.job.order.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">workshop_erp.report_job_orders</field>
        <field name="report_file">workshop_erp.report_job_orders</field>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_student_report"/>
    </record>
</odoo>
