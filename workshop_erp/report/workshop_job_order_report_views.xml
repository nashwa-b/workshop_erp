<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- custom pager format -->
<record id="paperformat_student_report" model="report.paperformat">
    <field name="name">Custom Paperformat for the Student report</field>
    <field name="default" eval="False"/>
    <field name="disable_shrinking" eval="True"/>
    <field name="format">A3</field>
    <field name="page_height">0</field>
    <field name="page_width">0</field>
    <!-- this one is to make the pdf to become horizontal, if landscape=False, pdf will become vertical -->
    <field name="orientation">Landscape</field>
    <field name="margin_top">0</field>
    <field name="margin_bottom">8</field>
    <field name="margin_left">0</field>
    <field name="margin_right">0</field>
    <field name="dpi">96</field>
</record>

<record id="action_report_joborder" model="ir.actions.report">
        <field name="name">job order history</field>
        <field name="model">workshop.job.order.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">workshop_erp.report_job_orders</field>
        <field name="report_file">workshop_erp.report_job_orders</field>
<!--        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Quotation - %s' % (object.name)) or 'Order - %s' % (object.name)</field>-->
<!--        <field name="binding_model_id" ref="model_workshop_job_order"/>-->
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_student_report"/>

    </record>
</odoo>
