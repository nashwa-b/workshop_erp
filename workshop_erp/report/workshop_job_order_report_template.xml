<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_job_orders">
        <t t-foreach="docs" t-as="order">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <center>
                        <h2> Job Orders
<!--                            <span t-field="order.name"/>-->
                        </h2>
                        </center>
<!--                        <div>-->
<!--                            <strong>Expected Price: </strong>-->
<!--                            <span t-field="order.expected_price"/>-->
<!--                        </div>-->
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Job Order</th>
                                    <th>Customer</th>
                                    <th>Job Date</th>
                                    <th>Vehicle</th>
                                    <th>Bay</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
<!--                                <tr t-foreach="order.order_line_ids" t-as="line">-->
                                <tr>
                                 <td>
                                        <span t-field="order.name"/>
                                    </td>
                                    <td>
                                        <span t-field="order.customer_id"/>
                                    </td>
                                    <td>
                                        <span t-field="order.job_date"/>
                                    </td>
                                    <td>
                                        <span t-field="order.vehicle_id"/>
                                    </td>
                                    <td>
                                        <span t-field="order.bay_id"/>
                                    </td>
                                <td>
                                        <span t-field="order.total"/>
                                    </td>
                                <td>
                                        <span t-field="order.status"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>