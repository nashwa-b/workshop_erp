                <t t-call="web.external_layout">
                    <div class="page">
                        <center>
                        <h2> Job Orders
<!--                            <span t-field="order.name"/>-->
                        </h2>
                        </center>
                        <left>
                           <b t-if ="wizard.customer_id">Customer:</b>
                            <span t-field="wizard.customer_id"/>
                            <br>
                            <b t-if ="wizard.vehicle_id">Vehicle:</b>
                            <span t-field="wizard.vehicle_id"/></br>
                            <br>
                                <b>Start Date:</b>
                            <span t-field="wizard.start_date"/></br>
                            <br>
                                <b>End Date:</b>
                            <span t-field="wizard.end_date"/></br>
                        </left>
<!--                                <t t-foreach="wizard" t-as="wiz">-->
