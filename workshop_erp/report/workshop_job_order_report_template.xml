<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_job_orders">
        <t t-foreach="docs" t-as="order">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span t-field="order.name"/>
                        </h2>
<!--                        <div>-->
<!--                            <strong>Expected Price: </strong>-->
<!--                            <span t-field="order.expected_price"/>-->
<!--                        </div>-->
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>Unit Price</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="order.order_line_ids" t-as="line">
                                    <td>
                                        <span t-field="line.product_id"/>
                                    </td>
                                    <td>
                                        <span t-field="line.product_qty"/>
                                    </td>
                                    <td>
                                        <span t-field="line.price_unit"/>
                                    </td>
                                    <td>
                                        <span t-field="line.sub_total"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>