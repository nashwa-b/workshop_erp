<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_job_orders">
        <t t-call="web.html_container">
        <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page">
                        <center>
                        <h2> Job Orders
<!--                            <span t-field="order.name"/>-->
                        </h2>
                        </center>
                        <left>

                            Customer:
                            <span t-field="wizard.customer_id"/>
                            <br>

                            Vehicle:
                            <span t-field="wizard.vehicle_id"/></br>
                            <br>

                            Start Date:
                            <span t-field="wizard.start_date"/></br>
                            <br>

                           End Date:
                            <span t-field="wizard.end_date"/></br>
                        </left>


                        <table class="table">
                            <thead>
                                <tr>
                                    <th><b>SI No</b></th>
                                    <th><b>Job Order</b></th>
                                    <th t-if ="not wizard.customer_id"><b>Customer</b></th>
                                    <th><b>Job Date</b></th>
                                    <th t-if ="not wizard.vehicle_id"><b>Vehicle</b></th>
                                    <th><b>Bay</b></th>
                                    <th><b>Total</b></th>
                                    <th><b>Status</b></th>
                                </tr>
                            </thead>
<!--                        <p>ldd</p>-->
                            <tbody>
<!--                                <span t-esc="len(data.get('report',[]))"/>-->
                                <t t-foreach="data['report']" t-as="line">
                                <tr>
<!--                                     <t t-if="!wizard.vehicle_id">-->
                                    <td>
                                       <span t-esc="line_index + 1"/>
                                    </td>
                                 <td>
                                        <span t-esc="line['name']"/>
                                    </td>
                                    <td t-if ="not wizard.customer_id">
                                        <span t-esc="line['customer']"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['job_date']"/>
                                    </td>
                                    <td t-if ="not wizard.vehicle_id">
                                        <span t-esc="line['vehicle']"/>
<!--                                        <span t-out="t-esc.get('en_US')"/>-->
                                    </td>
                                    <td>
                                        <span t-esc="line['bay']"/>
                                    </td>
                                <td>
                                        <span t-esc="line['total']"/>
                                    </td>
                                <td>
                                        <span t-esc="line['status']"/>
                                    </td>



<!--                                    <span t-out="str(o.your_json_field)"/>-->

<!--                                    &lt;!&ndash; Parse the JSON string into a Python dictionary &ndash;&gt;-->
<!--<t t-set="json_data" t-value="json.loads(o.your_json_field or '{}')"/>-->

<!--&lt;!&ndash; Output the specific key as text &ndash;&gt;-->
<!--<span t-out="json_data.get('customer_name')"/>-->

                                </tr>

                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
                </t>
                </t>
<!--            </t>-->
<!--        </t>-->
    </template>
</odoo>