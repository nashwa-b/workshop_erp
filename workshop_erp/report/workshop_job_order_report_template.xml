                              <table  class="table table-borderless o_main_table" style="margin-top: 20px;">


                            <thead>
                                <tr>
                                    <th><b>Sl No</b></th>
                                    <th t-if ="not wizard.customer_id"><b>Customer</b></th>
                                    <th><b>Job Date</b></th>
                                    <th t-if ="not wizard.vehicle_id"><b>Vehicle</b></th>
<!--                                    <th><b>Bay</b></th>-->
                                    <th><b>Total</b></th>
                                    <th><b>Status</b></th>
                                    <th t-if ="wizard.detailed_view"><b>Warranty</b></th>
                                    <th t-if ="wizard.detailed_view"><b>Collected</b></th>
                                    <th t-if ="wizard.detailed_view"><b>Company</b></th>
                                    <th t-if ="wizard.detailed_view"><b>Sale Order No</b></th>
                                    <th t-if ="wizard.detailed_view"><b>Invoice No</b></th>
<!--                                    <th t-if ="wizard.detailed_view"><b>Orders</b></th>-->
                                </tr>
                            </thead>
<!--                        <p>ldd</p>-->
                            <tbody>
<!--                                <span t-esc="len(data.get('report',[]))"/>-->
                                <t t-foreach="data['report']" t-as="line">
                                <tr>
<!--                                     <t t-if="!wizard.vehicle_id">-->
                                    <td>
                                       <span t-esc="line_index + 1"/>
                                    </td>

                                    <td t-if ="not wizard.customer_id">
                                        <span t-esc="line['customer']"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['job_date']"/>
                                    </td>
                                    <td t-if ="not wizard.vehicle_id">
                                        <span t-esc="line['vehicle']"/>
                                    </td>
<!--                                    <td>-->
<!--                                        <span t-esc="line['bay']"/>-->
<!--                                    </td>-->
                                <td>
                                        <span t-esc="line['total']"/>
                                    </td>
                                <td>
                                        <span t-esc="line['status']"/>
                                    </td>
                                    <td t-if ="wizard.detailed_view">
                                        <span t-esc="line['warranty']"/>
                                    </td>
                                    <td t-if ="wizard.detailed_view">
                                        <span t-esc="line['collected']"/>
                                    </td>
                                    <td t-if ="wizard.detailed_view">
                                        <span t-esc="line['company']"/>
                                    </td>
                                    <td t-if ="wizard.detailed_view">
                                        <span t-esc="line['sale']"/>
                                    </td>
                                    <td t-if ="wizard.detailed_view">
                                        <span t-esc="line['invoice']"/>
                                    </td>
<!--                                     <t t-set="offers" t-value="wizard.mapped('order_line_ids')"/>-->
<!--                                <tr t-foreach="offers" t-as="offer">-->
<!--                                    <td>-->
<!--                                        <span t-field="offer.product_id"/>-->
<!--                                    </td>-->
<!--                                    <td>-->
<!--                                        <span t-esc="line['orders']"/>-->
<!--                                    </td>-->
                                </tr>
<!--                                </tr>-->

                                </t>
<!--                                </t>-->

                            </tbody>
                        </table>


                         <table t-if ="wizard.detailed_view" class="table table-borderless o_main_table" style="margin-top: 20px;">
                            <thead>
                                <tr>
                                    <th><b>Product</b></th>
                                    <th><b>Quantity</b></th>
                                    <th><b>Unit Price</b></th>
                                    <th><b>Sub Total</b></th>

                                </tr>
                            </thead>
<!--                        <p>ldd</p>-->
                            <tbody>
<!--                                <span t-esc="len(data.get('report',[]))"/>-->
                                <t t-foreach="data['report']" t-as="line">
                                <tr>
                                 <td>
                                     <span t-esc="line['product']"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['quantity']"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['unit_price']"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['total']"/>
                                    </td>

                                </tr>
<!--                                </tr>-->

                                </t>

                            </tbody>
                        </table>
<!--                          </t>-->

                    </div>
                </t>
<!--                                    </t>-->
<!--                </t>-->
                </t>
            </t>
<!--        </t>-->
    </template>
</odoo>