<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_job_orders">
        <t t-call="web.html_container">
        <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page">
                        <center>
                        <h2> Job Orders
<!--                            <span t-field="order.name"/>-->
                        </h2>
                        </center>
<!--                        <div>-->
<!--                            <strong>Expected Price: </strong>-->
<!--                            <span t-field="order.expected_price"/>-->
<!--                        </div>-->
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Job Order</th>
                                    <th>Customer</th>
                                    <th>Job Date</th>
                                    <th>Vehicle</th>
                                    <th>Bay</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
<!--                                <span t-esc="len(data.get('report',[]))"/>-->
                                <t t-foreach="data['report']" t-as="line">
                                <tr>
                                 <td>
                                        <span t-esc="line['name']"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['customer']"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['job_date']"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['vehicle']"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['bay']"/>
                                    </td>
                                <td>
                                        <span t-esc="line['total']"/>
                                    </td>
                                <td>
                                        <span t-esc="line['status']"/>
                                    </td>
                                </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
                </t>
                </t>
<!--            </t>-->
<!--        </t>-->
    </template>
</odoo>