<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_job_orders">
          <t t-foreach="docs" t-as="wizard">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                         <center>
                            <h2>Job Orders
                            </h2>
                        </center>
                        <div style="margin-top: 60px;">
                            <b t-if="wizard.customer_id">Customer:</b>
                            <span t-field="wizard.customer_id"/>
                            <br>
                                <b t-if="wizard.vehicle_id">Vehicle:</b>
                                <span t-field="wizard.vehicle_id"/>
                            </br>
                            <br>
                                <b>Start Date:</b>
                                <span t-field="wizard.start_date"/>
                            </br>
                            <br>
                                <b>End Date:</b>
                                <span t-field="wizard.end_date"/>
                            </br>
                        </div>
                        <t t-foreach="data['report']" t-as="line">
                            <t t-set="job_order" t-value="env['workshop.job.order'].browse(line['job_order_id'])"/>
                            <br>
                                <h2>
                                    <span t-field="job_order.name"/>
                                </h2>
                                <table class="table" style="margin-top: 20px;">
                                    <thead>
                                        <tr>
                                            <th>
                                                <b>Sl No</b>
                                            </th>
                                            <th t-if="not wizard.customer_id">
                                                <b>Customer</b>
                                            </th>
                                            <th>
                                                <b>Job Date</b>
                                            </th>
                                            <th t-if="not wizard.vehicle_id">
                                                <b>Vehicle</b>
                                            </th>
                                            <th>
                                                <b>Total</b>
                                            </th>
                                            <th>
                                                <b>Status</b>
                                            </th>
                                            <th t-if="wizard.detailed_view">
                                                <b>Warranty</b>
                                            </th>
                                            <th t-if="wizard.detailed_view">
                                                <b>Collected</b>
                                            </th>
                                            <th t-if="wizard.detailed_view">
                                                <b>Company</b>
                                            </th>
                                            <th t-if="wizard.detailed_view">
                                                <b>Sale Order No</b>
                                            </th>
                                            <th t-if="wizard.detailed_view">
                                                <b>Invoice No</b>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <span t-esc="line_index + 1"/>
                                            </td>

                                            <td t-if="not wizard.customer_id">
                                                <span t-esc="line['customer']"/>
                                            </td>
                                            <td>
                                                <span t-esc="line['job_date']"/>
                                            </td>
                                            <td t-if="not wizard.vehicle_id">
                                                <span t-esc="line['vehicle']"/>
                                            </td>
                                            <td>
                                                <span t-esc="line['total']"/>
                                            </td>
                                            <td>
                                                <span t-esc="line['status']"/>
                                            </td>
                                            <td t-if="wizard.detailed_view">
                                                <span t-esc="line['warranty']"/>
                                            </td>
                                            <td t-if="wizard.detailed_view">
                                                <span t-esc="line['collected']"/>
                                            </td>
                                            <td t-if="wizard.detailed_view">
                                                <span t-esc="line['company']"/>
                                            </td>
                                            <td t-if="wizard.detailed_view">
                                                <span t-esc="line['sale']"/>
                                            </td>
                                            <td t-if="wizard.detailed_view">
                                                <span t-esc="line['invoice']"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </br>
                          <b> <h4 t-if="wizard.detailed_view">Job Lines</h4></b>
                            <table t-if="wizard.detailed_view" class="table table-borderless o_main_table"
                                   style="margin-top: 20px;">
                                <thead>
                                    <tr>
                                        <th>
                                           Product
                                        </th>
                                        <th>
                                            Quantity
                                        </th>
                                        <th>
                                           Unit Price
                                        </th>
                                        <th>
                                            Sub Total
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="job_order.order_line_ids" t-as="order_line">
                                        <tr>
                                            <td>
                                                <span t-field="order_line.product_id"/>

                                            </td>
                                            <td>
                                                <span t-field="order_line.product_qty"/>
                                            </td>
                                            <td>
                                                <span t-field="order_line.price_unit"/>
                                            </td>
                                            <td>
                                                <span t-field="order_line.sub_total"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>