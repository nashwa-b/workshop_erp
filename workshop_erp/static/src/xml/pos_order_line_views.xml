<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
   <t t-name="workshop_erp.Orderlines" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
 <xpath expr="//div[hasclass('product-price')]" position="after">
<!--     <button class="btn btn-secondary btn-lg py-5" t-on-click="() => this.onClickPopup()">-->
     <button class="btn btn-link btn-lg text-danger fa fa-trash"  t-on-click="() => this._onClickRemoveEachLine()">
            </button>
       </xpath>
   </t>

      <t t-name="workshop_erp.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
       <xpath expr="//div/button[hasclass('o_pricelist_button')]" position="before">
            <button t-on-click="() => this._onClickRemoveLines()">
                <i class="fa fa-trash me-1" aria-label="Custom Alert" title="Custom Alert"/>Delete Order lines
            </button>
       </xpath>
   </t>


</templates>