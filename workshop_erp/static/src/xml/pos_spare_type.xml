<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//div[hasclass('product-img')]" position="before">
                <div t-if="props.product.spare_type" class="pos-ribbon">
                <t t-esc="props.product.spare_type_label"/>
            </div>
        </xpath>
    </t>

    <t t-name="pos_add_spare_type.Orderline"
       t-inherit="point_of_sale.Orderline"
       t-inherit-mode="extension">
        <xpath expr="//t[@t-esc='vals.name']" position="after">
           <span t-if="line.getProduct().spare_type"> |
               <t t-esc="line.getProduct().spare_type_label"/>
           </span>
       </xpath>
   </t>
</templates>


