<odoo>

     <record id="rule_workshop_job_order_receptionist" model="ir.rule">
        <field name="name">Receptionist</field>
        <field ref="model_workshop_job_order" name="model_id"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('workshop_erp.group_workshop_job_order_receptionist'))]"/>
    </record>

       <record id="rule_workshop_job_order_mechanic" model="ir.rule">
        <field name="name">Mechanic</field>
        <field ref="model_workshop_job_order" name="model_id"/>
        <field name="domain_force">[('company_id', 'in', company_ids),('mechanic_ids','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('workshop_erp.group_workshop_job_order_mechanic'))]"/>
    </record>

       <record id="rule_workshop_job_order_manager" model="ir.rule">
        <field name="name">Manager</field>
        <field ref="model_workshop_job_order" name="model_id"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('workshop_erp.group_workshop_job_order_manager'))]"/>
    </record>

