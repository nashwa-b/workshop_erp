<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_workshop" model="ir.module.category">
        <field name="name">Workshop</field>
        <field name="sequence">10</field>
    </record>

    <record id="res_groups_privilege_workshop" model="res.groups.privilege">
        <field name="name">Workshop</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="workshop_erp.module_category_workshop"/>
    </record>


    <record id="group_workshop_job_order_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="privilege_id" ref="res_groups_privilege_workshop"/>
        <!--            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>-->
        <field name="comment">Receptionist can create and manage Job Orders but should not have access to Accounting
            configuration
        </field>

    </record>

    <record id="group_workshop_job_order_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_workshop"/>
        <!--        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>-->
        <!--                    <field name="implied_ids" eval="[(4, ref('workshop_erp.group_workshop_job_order_receptionist'))]"/>-->
        <field name="comment">Manager has full access to all Workshop records, reporting, and management features.
        </field>
    </record>

    <record id="group_workshop_job_order_mechanic" model="res.groups">
        <field name="name">Mechanic</field>
        <field name="privilege_id" ref="res_groups_privilege_workshop"/>
        <!--        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>-->
        <field name="comment">Mechanic can only view and update Job Orders assigned to them.</field>
    </record>

</odoo>

