<?xml version="1.0" encoding="utf-8"?>
<odoo>

     <record id="rule_workshop_bay_receptionist" model="ir.rule">
        <field name="name">Receptionist</field>
        <field ref="model_workshop_bay" name="model_id"/>
        <field name="groups" eval="[(4, ref('workshop_erp.group_workshop_job_order_receptionist'))]"/>
    </record>

       <record id="rule_workshop_bay_mechanic" model="ir.rule">
        <field name="name">Mechanic</field>
        <field ref="model_workshop_bay" name="model_id"/>
        <field name="domain_force">[('employee_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('workshop_erp.group_workshop_job_order_mechanic'))]"/>
    </record>

       <record id="rule_workshop_bay_manager" model="ir.rule">
        <field name="name">Manager</field>
        <field ref="model_workshop_bay" name="model_id"/>
        <field name="groups" eval="[(4, ref('workshop_erp.group_workshop_job_order_manager'))]"/>
    </record>
</odoo>