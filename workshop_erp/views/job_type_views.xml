<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="job_type_view_list" model="ir.ui.view">
            <field name="name">job.type.view.list</field>
            <field name="model">job.type</field>
            <field name="arch" type="xml">
                <list string="Job Type">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="job_type_view_form" model="ir.ui.view">
            <field name="name">job.type.view.form</field>
            <field name="model">job.type</field>
            <field name="arch" type="xml">
                <list string="Job Type" editable="bottom">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="job_type_action" model="ir.actions.act_window">
            <field name="name">Job Type</field>
            <field name="res_model">job.type</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click here to create your first Job Type.
                </p>
            </field>
        </record>
    </data>
</odoo>




