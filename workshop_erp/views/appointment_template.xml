<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="appointment" name="Job Orders Custom Layout">
        <t t-call="website.layout">
            <div class="container">
                <br>
                    <form action="/createappointment" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="col-md-6 mb-3">

                                    <label for="subject">Subject
                                    </label>
                                    <!--                                   <div class="col-sm">-->
                                    <input id="subject" name="name" type="text" class="form-control"
                                        />
                                </div>



                          <div class="col-md-6 mb-3">
                                    <!--                                  <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="customer_id">
                                        Customer
                                    </label>
                                    <div class="col-sm">
                                        <select name="customer_id" class="form-control">
                                            <t t-foreach="customer" t-as="rec">
                                                <option t-att-value="rec.id">
                                                    <t t-esc="rec.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <!--                                  </div>-->
                                </div>
<!--                        <div class="col-md-6 mb-3">-->

<!--                                    <label for="name">Name-->
<!--                                    </label>-->
<!--                                    &lt;!&ndash;                                   <div class="col-sm">&ndash;&gt;-->
<!--                                    <input id="name" name="name" type="text" class="form-control"-->
<!--                                        />-->
<!--                                </div>-->
                          <div class="col-md-6 mb-3">

                                    <label for="start_date">Start
                                    </label>
                                    <!--                                   <div class="col-sm">-->
                                    <input id="start_date" name="start_date" type="datetime-local" class="form-control"
                                        />
                                </div>
                        <div class="col-md-6 mb-3">

                                    <label for="end_date">End
                                    </label>
                                    <!--                                   <div class="col-sm">-->
                                    <input id="end_date" name="end_date" type="datetime-local" class="form-control"
                                        />
                                </div>
                         <div class="col-md-6 mb-3">
                                    <!--                                  <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="vehicle_id">
                                        Vehicle
                                    </label>
                                    <div class="col-sm">
                                        <select name="vehicle_id" class="form-control">
                                            <t t-foreach="vehicles" t-as="rec">
                                                <option t-att-value="rec.id">
                                                    <t t-esc="rec.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <!--                                  </div>-->
                                </div>

                                <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end">
<!--                                                            <a href="/webformsubmit" class="btn btn-primary rounded-3">Submit</a>-->

                                  <button type="submit" class="btn btn-primary">Confirm</button>

                                </div><br> </br>

                    </form>
                </br>
            </div>
        </t>
    </template>
</odoo>

