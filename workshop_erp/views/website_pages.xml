<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Customer Create Form Template -->
        <template id="workshop_list_template" name="Job Orders">
            <t t-call="website.layout">
                <section class="d-flex align-items-center justify-content-center vh-100" style="background-color: #f8f9fa;">
                    <div class="card shadow-lg rounded-4" style="width: 400px;">
                        <div class="card-body p-5">
                            <h3 class="text-center mb-4">Create Customer</h3>
                            <list action="/website/job_order/create" method="post">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Name</label>
                                    <input type="text" name="name" class="form-control rounded-2"/>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Email</label>
                                    <input type="email" name="email" class="form-control rounded-2"/>
                                </div>
                                <div class="mb-4">
                                    <label class="form-label fw-semibold">Phone</label>
                                    <input type="text" name="phone" class="form-control rounded-2"/>
                                </div>
                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary btn-block rounded-3 py-2">
                                        Submit
                                    </button>
                                </div>
                            </list>
                        </div>
                    </div>
                </section>
            </t>
        </template>
        <!-- Website Menu Record -->
<!--        <record id="menu_customer_form" model="website.menu">-->
<!--            <field name="name">Create Customer</field>-->
<!--            <field name="url">/website/customer/form</field>-->
<!--            <field name="parent_id" ref="website.main_menu"/>-->
<!--            <field name="sequence" type="int">90</field>-->
<!--        </record>-->

        <record id="menu_website" model="website.menu">
    <field name="name">Workshop</field>
    <field name="url">/website/job_order/form</field>
<!--    <field name="page_id" ref="workshop_erp.workshop_list_template"/>-->
    <field name="parent_id" ref="website.main_menu"/>
    <field name="sequence">50</field>
        </record>
    </data>
</odoo>
