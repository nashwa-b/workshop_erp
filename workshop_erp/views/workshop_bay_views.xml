<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="workshop_bay_view_list" model="ir.ui.view">
            <field name="name">workshop.bay.view.list</field>
            <field name="model">workshop.bay</field>
            <field name="arch" type="xml">
                <list string="Bay">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="type"/>
                    <field name="status" widget="badge"/>
                    <field name="ongoing_job_id"/>
                </list>
            </field>
        </record>


        <record id="workshop_bay_view_form" model="ir.ui.view">
            <field name="name">workshop.bay.view.form</field>
            <field name="model">workshop.bay</field>
            <field name="arch" type="xml">
                <form string="Bay">
                    <header>
                        <field name="status" widget="statusbar" statusbar_visible="free,occupied"/>
                        <button name="action_open" string="Open" class="oe_highlight" type="object"
                                invisible="status !='closed'"/>
                        <button name="action_close" string="Close" class="oe_highlight" type="object"
                                invisible="status !='free'"/>
                    </header>
                    <sheet>
                        <div class="oe-title">
                            <h1>
                                <field name="name" placeholder="Bay Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="type"/>
                            </group>
                            <group>
                                <field name="ongoing_job_id"/>
                            </group>
                        </group>
                        <div class="oe_chatter">
                            <chatter/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="workshop_bay_action" model="ir.actions.act_window">
            <field name="name">Bay</field>
            <field name="res_model">workshop.bay</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click here to create your first Bay.
                </p>
            </field>
        </record>

    </data>
</odoo>




