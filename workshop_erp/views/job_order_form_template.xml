<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="web_form_template">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <div class="container" style="display: flex; gap: 20px; margin-top:30px;">
                    <br>
                        <form action="/webformsubmit" method="post">
                            <a href="/joborders">Job Orders</a>
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="customer_id">
                                        Customer
                                    </label>
                                    <div class="col-sm">
                                        <select name="customer_id" class="form-control" t-att-value='user_name'>
                                            <t t-foreach="customers" t-as="rec">
                                                <option t-att-value="rec.id">
                                                    <t t-esc="rec.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="phone">
                                        Phone Number
                                    </label>
                                    <input id="phone" name="phone" type="tel" class="form-control s_website_form_input"
                                           t-att-value='phone'/>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="job_date">
                                        Job Date
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input id="job_date" name="job_date" type="datetime-local" class="form-control"
                                           t-att-value='dates' required='1'/>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="vehicle_id">
                                        Vehicle
                                    </label>
                                    <div class="col-sm">
                                        <select name="vehicle_id" class="form-control">
                                            <t t-foreach="vehicles" t-as="rec">
                                                <option t-att-value="rec.id">
                                                    <t t-esc="rec.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <!--                                  </div>-->
                                </div>

                                <div class="col-md-6 mb-3">
                                    <!--                                  <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="job_type_id">
                                        Job Type
                                    </label>
                                    <div class="col-sm">
                                        <select name="job_type_id" class="form-control">
                                            <t t-foreach="job_types" t-as="rec">
                                                <option t-att-value="rec.id">
                                                    <t t-esc="rec.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <!--                                  </div>-->
                                </div>


                                <div class="col-md-6 mb-3">
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="bay_id">Bay
                                    </label>
                                    <div class="col-sm">
                                        <select name="bay_id" class="form-control">
                                            <t t-foreach="bays" t-as="rec">
                                                <option t-att-value="rec.id">
                                                    <t t-esc="rec.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                </div>
                                <!--                </div>-->

                                <div class="col-md-6 mb-3">
                                    <!--                                  <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="mechanic_ids">
                                        Mechanic
                                    </label>
                                    <!--                                    <div class="col-sm">-->
                                    <select name="mechanic_ids" id="mechanic_ids" class="form-control"
                                            multiple="multiple">
                                        <t t-foreach="mechanic_ids" t-as="rec">
                                            <option t-att-value="rec.id">
                                                <t t-esc="rec.name"/>
                                            </option>
                                        </t>
                                    </select>

                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="total">
                                        Total
                                    </label>
                                    <!--                                   <div class="col-sm">-->
                                    <input id="total" type="char" class="form-control total" name="total"/>
                                </div>
                            </div>

                            <table class="table table-bordered mt-3" id="job_line_table">
                                <thead>
                                    <tr>
                                        <th>
                                            Product
                                        </th>
                                        <th>
                                            Quantity
                                        </th>
                                        <th>
                                            Unit Price
                                        </th>
                                        <th>
                                            Sub Total
                                        </th>
                                        <th width="5%"></th>

                                    </tr>
                                </thead>

                                <tbody>
                                    <tr class="job_order_line">
                                        <td>
                                            <select name="product" class="form-control product_id">
                                                <option value="">Select Product</option>

                                                <t t-foreach="products" t-as="product">
                                                    <option t-att-value="product.id"
                                                            t-att-data-price="product.list_price">

                                                        <t t-esc="product.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </td>
                                        <td>
                                            <input id="quantity" name="quantity" type="number" value="1"
                                                   placeholder="Quantity" class="form-control quantity"/>
                                        </td>
                                        <td>
                                            <input id="price_unit" type="char" class="form-control price_unit"
                                                   name="price_unit" t-att-value='price_unit'/>
                                        </td>
                                        <td>
                                            <input id="sub_total" type="char" class="form-control" name="sub_total"
                                                   t-att-value='price_unit'/>
                                        </td>
                                        <td>
                                            <button type="button" class="btn fa fa-trash-o remove_line text-danger"></button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <!-- Add Material Button -->
                            <div class="col-12 text-end">
                                <button type="button" class="btn btn-info add_total_project">
                                    <i class="fa fa-plus"></i>
                                    Add Line
                                </button>
                            </div>
                            <div style="display: flex; gap: 20px; margin-bottom:20px;" class="col-12 mt-3">
                                <button type="submit" class="btn btn-primary">Confirm</button>
                            </div>
                        </form>
                    </br>
                </div>
            </div>
        </t>
    </template>
</odoo>
