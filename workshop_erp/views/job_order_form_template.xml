<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="web_form_template">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="s_website_form">
                    <div class="container">
                        <form action="/webformsubmit" enctype="multipart/form-data" class="o_mark_required"
                              method="POST">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <!-- Name Field -->
                            <div class="s_website_form_rows row s_col_no_bgcolor">
                                <div class="col-xs-6">
                                    <!--                               <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 100px;"
                                           data-fill-with='user_name' for="name">
                                        Name
                                        <span class="text-danger">*</span>
                                    </label>
                                    <!--                                   <div class="col-sm">-->
                                    <input id="name" type="text" class="form-control" t-att-value='user_name'
                                           required="1"/>
                                </div>

                                <div class="col-xs-6">
                                    <!--                               <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="phone">
                                        Phone Number
                                        <span class="text-danger">*</span>
                                    </label>
                                    <!--                                   <div class="col-sm">-->
                                    <input id="phone" type="tel" class="form-control s_website_form_input" t-att-value='phone'/>
                                </div>
                                <!--                               </div>-->

                                <!-- Phone Field -->
                                <div class="col-xs-6">
                                    <!--                               <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="job_date">
                                        Job Date
                                        <span class="text-danger">*</span>
                                    </label>
                                    <!--                                   <div class="col-sm">-->
                                    <input id="job_date" type="datetime-local" class="form-control" name="job_date" t-att-value='dates'/>
                                    <!--                                   </div>-->
                                </div>
                                <div class="form-group col-12">
                                    <!--                                  <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="vehicle_id">
                                        Vehicle
                                    </label>
                                    <div class="col-sm">
                                        <select name="vehicle_id" class="form-control">
                                            <t t-foreach="vehicles" t-as="rec">
                                                <option t-att-value="rec.id">
                                                    <t t-esc="rec.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <!--                                  </div>-->
                                </div>

                                <div class="form-group col-12">
                                    <!--                                  <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="mechanic_ids">
                                        Job Type
                                    </label>
                                    <div class="col-sm">
                                        <select name="job_types" class="form-control">
                                            <t t-foreach="job_types" t-as="rec">
                                                <option t-att-value="rec.id">
                                                    <t t-esc="rec.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <!--                                  </div>-->
                                </div>


                                <div class="form-group col-12">
                                    <!--                                  <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="bay_id">Bay
                                    </label>
                                    <div class="col-sm">
                                        <select name="bays" class="form-control">
                                            <t t-foreach="job_types" t-as="rec">
                                                <option t-att-value="rec.id">
                                                    <t t-esc="rec.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                </div>
                                <!--                </div>-->

                                <div class="form-group col-12">
                                    <!--                                  <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="mechanic_ids">
                                        Mechanic
                                    </label>
                                    <div class="col-sm">
                                        <select name="mechanic_ids" class="form-control">
                                            <t t-foreach="mechanics" t-as="rec">
                                                <option t-att-value="rec.id">
                                                    <t t-esc="rec.name"/>
                                                </option>
                                            </t>
                                        </select>
                                        <!--                                          </div>-->
                                    </div>
                                </div>

                                <div class="col-xs-6">
                                    <!--                               <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="total">
                                        Total
                                        <span class="text-danger">*</span>
                                    </label>
                                    <!--                                   <div class="col-sm">-->
                                    <input id="name" type="number" class="form-control" name="name"/>
                                </div>

                                <table class="table table-borderless o_main_table"
                                       style="margin-top: 20px;">
                                    <thead>
                                        <tr>
                                            <th>
                                                Product
                                            </th>
                                            <th>
                                                Quantity
                                            </th>
                                            <th>
                                                Unit Price
                                            </th>
                                            <th>
                                                Sub Total
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        <!--                                    <t t-foreach="job_order.order_line_ids" t-as="order_line">-->
                                        <tr>
                                            <td>
                                                <!--                                                              <div class="form-group col-12">-->
                                                <!--                                  <div class="row">-->
                                                <!--                                          <div class="col-sm">-->
                                                <select name="products" class="order_line_row">
                                                    <t t-foreach="products" t-as="rec">
                                                        <option t-att-value="rec.id">
                                                            <t t-esc="rec.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                                <!--                                          </div>-->
                                                <!--                                  </div>-->
                                                <!--                </div>-->

                                            </td>
                                            <td>
                                                j
                                            </td>
                                            <td>
<!--                                                 <label class="col-form-label col-sm-auto" style="width: 200px;" for="price_unit">-->
<!--                                        Job Date-->
<!--                                        <span class="text-danger">*</span>-->
<!--                                    </label>-->
                                    <!--                                   <div class="col-sm">-->
<!--                                    <input id="price_unit" type="number" class="form-control" name="price_unit" t-att-value='price_unit'/>-->
                                    <!--                                   </div>-->
                                            </td>
                                            <td>
                                                o
                                            </td>
                                        </tr>
                                        <!--                                    </t>-->
                                    </tbody>
                                </table>


                                <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end">


                                    <!--                               <div class="d-grid" style="width: 200px;">-->
                                    <button type="submit" class="btn btn-primary">Submit</button>
                                </div>
                                <!--                       </div>-->
                            </div>

                        </form>
                    </div>
                </section>
            </div>
        </t>
    </template>
</odoo>
