<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="web_form_template">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
<!--                <section class="s_website_form">-->
                    <div class="container">
                        <br>
                        <form action="/webformsubmit" method="post">

                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <!-- Name Field -->
                            <div class="row">
                                  <div class="col-md-6 mb-3">
                                    <!--                                  <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="customer_id">
                                        Customer
                                    </label>
                                    <div class="col-sm">
                                        <select name="customer_id" class="form-control" t-att-value='user_name'>
                                            <t t-foreach="customers" t-as="rec">
                                                <option t-att-value="rec.id">
                                                    <t t-esc="rec.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <!--                                  </div>-->
                                </div>
<!--                                <div class="col-md-6 mb-3">-->
<!--                                    <label for="name">Name-->
<!--                                        <span class="text-danger">*</span>-->
<!--                                    </label>-->
<!--                                    &lt;!&ndash;                                   <div class="col-sm">&ndash;&gt;-->
<!--                                    <input id="name" name="name" type="text" class="form-control" t-att-value='user_name'-->
<!--                                           required="1"/>-->
<!--                                </div>-->

                                  <div class="col-md-6 mb-3">
                                    <!--                               <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="phone">
                                        Phone Number
                                        <span class="text-danger">*</span>
                                    </label>
                                    <!--                                   <div class="col-sm">-->
                                    <input id="phone" name = "phone" type="tel" class="form-control s_website_form_input" t-att-value='phone'/>
                                </div>
                                <!--                               </div>-->

                                <!-- Phone Field -->
                                  <div class="col-md-6 mb-3">
                                    <!--                               <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="job_date">
                                        Job Date
                                        <span class="text-danger">*</span>
                                    </label>
                                    <!--                                   <div class="col-sm">-->
                                    <input id="job_date"  name="job_date" type="datetime-local" class="form-control" t-att-value='dates'/>
                                    <!--                                   </div>-->
                                </div>
                                   <div class="col-md-6 mb-3">
                                    <!--                                  <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="vehicle_id">
                                        Vehicle
                                    </label>
                                    <div class="col-sm">
                                        <select name="vehicle_id" class="form-control">
                                            <t t-foreach="vehicles" t-as="rec">
                                                <option t-att-value="rec.id">
                                                    <t t-esc="rec.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <!--                                  </div>-->
                                </div>

                                   <div class="col-md-6 mb-3">
                                    <!--                                  <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="job_type_id">
                                        Job Type
                                    </label>
                                    <div class="col-sm">
                                        <select name="job_type_id" class="form-control">
                                            <t t-foreach="job_types" t-as="rec">
                                                <option t-att-value="rec.id">
                                                    <t t-esc="rec.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                    <!--                                  </div>-->
                                </div>


                                  <div class="col-md-6 mb-3">
                                    <!--                                  <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="bay_id">Bay
                                    </label>
                                    <div class="col-sm">
                                        <select name="bay_id" class="form-control">
                                            <t t-foreach="bays" t-as="rec">
                                                <option t-att-value="rec.id">
                                                    <t t-esc="rec.name"/>
                                                </option>
                                            </t>
                                        </select>
                                    </div>
                                </div>
                                <!--                </div>-->

                                   <div class="col-md-6 mb-3">
                                    <!--                                  <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="mechanic_ids">
                                        Mechanic
                                    </label>
<!--                                    <div class="col-sm">-->
                                        <select name="mechanic_ids" id = "mechanic_ids" class="form-control" multiple="multiple">
                                            <t t-foreach="request.env['hr.employee'].sudo().search([])" t-as="rec">
                                                <option t-att-value="rec.id">
                           <t t-esc="rec.name"/>
                       </option>
                                            </t>
                                        </select>
                                        <!--                                          </div>-->
<!--                                    </div>-->
<!--                                        <div class="form-group mt-3">-->

                                </div>

                                  <div class="col-md-6 mb-3">
                                    <!--                               <div class="row">-->
                                    <label class="col-form-label col-sm-auto" style="width: 200px;" for="total">
                                        Total
                                    </label>
                                    <!--                                   <div class="col-sm">-->
                                    <input id="total" type="number" class="form-control" name="total"/>
                                </div>
                            </div>

                                <table class="table table-bordered mt-3" id="material_table">
                                    <thead>
                                        <tr>
                                            <th>
                                                Product
                                            </th>
                                            <th>
                                                Quantity
                                            </th>
                                            <th>
                                                Unit Price
                                            </th>
                                            <th>
                                                Sub Total
                                            </th>
                                            <th width="5%"></th>

                                        </tr>
                                    </thead>

                                    <tbody>
                                        <!--                                    <t t-foreach="job_order.order_line_ids" t-as="order_line">-->
                                        <tr class="job_order_line">
                                            <td>
                                                <!--                                                              <div class="form-group col-12">-->
                                                <!--                                  <div class="row">-->
                                                <!--                                          <div class="col-sm">-->
                                                <select name="product" class="form-control s_website_form_input">
                                                                                                       <option value="">Select Product</option>

                                                    <t t-foreach="products" t-as="product">
                                                        <option t-att-value="product.id">
                                                            <t t-esc="product.name"/>
                                                        </option>
                                                    </t>
                                                </select>
                                                <!--                                          </div>-->
                                                <!--                                  </div>-->
                                                <!--                </div>-->

                                            </td>
                                            <td>
                                              <input id="quantity" name="quantity" type="number" value = "1" placeholder="Quantity" class="form-control"/>
                                            </td>
                                            <td>
<!--                                                 <label class="col-form-label col-sm-auto" style="width: 200px;" for="price_unit">-->
<!--                                        Job Date-->
<!--                                        <span class="text-danger">*</span>-->
<!--                                    </label>-->
<!--                                                                       <div class="col-sm">-->
                                    <input id="price_unit" type="number" class="form-control" name="price_unit" t-att-value='price_unit'/>
<!--                                                                       </div>-->
                                            </td>
                                            <td>
                                                                                    <input id="sub_total" type="number" class="form-control" name="sub_total" t-att-value='price_unit'/>

                                            </td>
                                             <td>
                                               <button type="button" class="btn fa fa-trash-o remove_line text-danger"></button>
                                           </td>
                                        </tr>
                                        <!--                                    </t>-->
                                    </tbody>
                                </table>
                                  <!-- Add Material Button -->
                           <div class="col-12 text-end">
                               <button type="button" class="btn btn-info add_total_project">
                                   <i class="fa fa-plus"></i>
                                   Add Line
                               </button>
                           </div>


                               <div class="col-12 mt-3">
  <button type="submit" class="btn btn-primary">Confirm</button>

                           </div>

                        </form>
                          </br>
                    </div>
<!--                </section>-->
            </div>
        </t>
    </template>
</odoo>
