<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_calendar_event_form_inherit_job_order" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.job.order</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
              <xpath expr="//field[@name='start']" position="after">
                    <field  name="job_order_id"/>
                  <field name="customer_id"/>
                </xpath>
            <xpath expr="//button[@name='action_open_composer']" position="after">
            </xpath>
             </field>
    </record>

    <record id="view_calendar_event_list_inherit_job_order" model="ir.ui.view">
        <field name="name">calendar.event.list.inherit.job.order</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_tree"/>
        <field name="arch" type="xml">
              <xpath expr="//field[@name='name']" position="after">
                    <field name="job_order_id"/>
                </xpath>
             </field>
    </record>


     <record id="calendar_event_action" model="ir.actions.act_window">
            <field name="name">Appointments</field>
            <field name="res_model">calendar.event</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('job_order_id', '!=', False)]</field>
<!--            <field name="search_view_id" ref="view_workshop_job_order_filter"/>-->
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click here to create your first Vehicle.
                </p>
            </field>
        </record>
</odoo>