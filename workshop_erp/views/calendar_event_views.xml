<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_calendar_event_form_inherit_job_order" model="ir.ui.view">
        <field name="name">calendar.event.form.inherit.job.order</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
              <xpath expr="//field[@name='start']" position="after">
                    <field  name="job_order_id"/>
                </xpath>
             </field>
    </record>

    <record id="view_calendar_event_list_inherit_job_order" model="ir.ui.view">
        <field name="name">calendar.event.list.inherit.job.order</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_tree"/>
        <field name="arch" type="xml">
              <xpath expr="//field[@name='name']" position="after">
                    <field name="job_order_id"/>
                </xpath>
             </field>
    </record>
</odoo>