<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_job_orders" name="Job Orders Custom Layout">
        <t t-call="website.layout">
            <div class="container">
<!--                <br>-->
                    <form action="/newjoborder" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
    <!-- put other forms field here if you need to pass info to controller -->
                                                                        <div class="mb-0 py-2 col-12 s_website_form_submit s_website_form_no_submit_label text-end" >


    <button type="submit" class="btn btn-primary">New Job Order</button>
                                                                        </div>
<!--                    <t t-name="button_on_form_view.FormView.Buttons" t-inherit="web.FormView">-->
<!--                        <xpath expr="//t[@t-set-slot='layout-buttons']" position="inside">-->
<!--                            <button type="button" class="btn btn-primary"-->
<!--                                t-on-click="OnFormClickOrder">-->
<!--              <span>New Job Order</span>-->
<!--                        </button>-->
<!--                        </xpath>-->
<!--</t></br>-->
                       <h1>Job Orders</h1>
                       <table class="table table-bordered table-striped mt-3">
                                    <thead>
                                        <tr>
                                            <th>
                                                <b>Sequence</b>
                                            </th>
                                            <th>
                                                <b>Date</b>
                                            </th>
                                            <th>
                                                <b>Customer</b>
                                            </th>
                                            <th>
                                                <b>Vehicle</b>
                                            </th>
                                            <th>
                                                <b>Total Amount</b>
                                            </th>
                                            <th>
                                                <b>Status</b>
                                            </th>
                                            </tr>
                                    </thead>
                           <tbody>
                                    <t t-foreach="job_orders" t-as="job_order">
                                        <tr>
                                            <td>
                                                <t t-esc="job_order.name"/>

                                            </td>
                                            <td>
                                                <t t-esc="job_order.job_date"/>

                                            </td>
                                            <td>
                                                <t t-esc="job_order.customer_id.name"/>
                                            </td>
                                            <td>
                                                <t t-esc="job_order.vehicle_id.name"/>
                                            </td>
                                            <td>
                                                <t t-esc="job_order.total"/>
                                            </td>
                                            <td>
                                                <t t-esc="job_order.status"/>
                                            </td>
                                        </tr>
                                    </t>
                                    </tbody>
                        </table>
                </form>
            </div>
        </t>
    </template>
</odoo>

