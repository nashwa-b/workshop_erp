<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="workshop_job_order_view_list" model="ir.ui.view">
            <field name="name">workshop.job.order.view.list</field>
            <field name="model">workshop.job.order</field>
            <field name="arch" type="xml">
                <list string="Bay">
                    <field name="name"/>
                    <field name="mechanic_ids"/>
                    <field name="status" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="workshop_job_order_view_graph" model="ir.ui.view">
            <field name="name">workshop.job.order.view.list</field>
            <field name="model">workshop.job.order</field>
            <field name="arch" type="xml">
                <list string="Bay">
                    <field name="name"/>
                    <field name="mechanic_ids"/>
                    <field name="status" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="workshop_job_order_view_pivot" model="ir.ui.view">
            <field name="name">workshop.job.order.view.pivot</field>
            <field name="model">workshop.job.order</field>
            <field name="arch" type="xml">
                <list string="Bay">
                    <field name="name"/>
                    <field name="mechanic_ids"/>
                    <field name="status" widget="badge"/>
                </list>
            </field>
        </record>


        <record id="workshop_job_order_reporting_action" model="ir.actions.act_window">
            <field name="name">Job Order</field>
            <field name="res_model">workshop.job.order</field>
            <field name="view_mode">list,form,graph,pivot</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click here to create your first Vehicle.
                </p>
            </field>
        </record>

         </data>
</odoo>






