<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="workshop_job_order_view_list" model="ir.ui.view">
            <field name="name">workshop.job.order.view.list</field>
            <field name="model">workshop.job.order</field>
            <field name="arch" type="xml">
                <list string="Job Order" default_order="name desc">
                    <field name="name" ref="base.main_company"/>
                    <field name="customer_id"/>
                    <field name="job_date"/>
                    <field name="vehicle_id"/>
                    <field name="mechanic_ids"/>
                    <field name="bay_id"/>
                    <field name="customer_note" optional="hide"/>
                    <field name="total" widget="monetary"/>
                    <field name="status" widget="badge"/>
                </list>
            </field>
        </record>

            <record id="workshop_job_order_history_view_list" model="ir.ui.view">
            <field name="name">workshop.job.order.history.view.list</field>
            <field name="model">workshop.job.order</field>
            <field name="arch" type="xml">
                <list string="Job Order Analysis" default_order="job_date desc">
                    <field name="name" ref="base.main_company"/>
                    <field name="customer_id"/>
                    <field name="job_date"/>
                    <field name="status" widget="badge"/>
                </list>
            </field>
        </record>

        <record id="workshop_job_order_view_form" model="ir.ui.view">
            <field name="name">workshop.job.order.view.form</field>
            <field name="model">workshop.job.order</field>
            <field name="arch" type="xml">

                <form string="Job Order">

                    <header>
                        <field name="status" widget="statusbar"
                               statusbar_visible="draft,confirmed,in_progress,done,invoiced"/>
                        <button name="action_confirm" string="Confirm" class="oe_highlight" type="object"
                                invisible="status != 'draft'"/>
                        <button name="action_start" string="Start" class="oe_highlight" type="object"
                                invisible="status != 'confirmed'"/>
                        <button name="action_done" string="Done" class="oe_highlight" type="object"
                                invisible="status != 'in_progress'"/>
                        <button name="action_view_sale_order" string="Create Invoice" class="oe_highlight" type="object"
                                invisible="not sale_order_id or status != 'done'"/>
                        <button name="action_invoiced" string="Create Invoice" class="oe_highlight" type="object"
                                invisible="not hide or (status != 'done') or sale_order_id"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                invisible="status !='draft'"/>
                         <field name="hide" invisible="1"/>
                        <button name="action_create_sale_order" string="Create Quotation" type="object" invisible="not customer_id or hide or sale_order_id"/>
                    </header>

                    <sheet>
                        <widget name="web_ribbon" title="Paid" bg_color="text-bg-success" invisible="not invoice_paid"/>

                        <div class="oe_button_box" name="button_box">

                            <!-- No groups attribute on the next button as "stock.group_stock_user" is needed for Repair, and as this group is granted 'sale.order' read/write accesses in sale_stock module (forcefully loaded as transitive dependency) -->

                            <button name="action_view_sale_order" type="object" string="Sale Order" icon="fa-dollar"
                                    class="oe_stat_button" invisible="not sale_order_id ">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value">
                                        <field name="sale_order_id" widget="statinfo" nolabel="1" class="mr4"/>
                                    </span>
                                    <span class="o_stat_text">Sale Order</span>
                                </div>
                            </button>

                            <button name="action_view_invoice" type="object" class="oe_stat_button"
                                    icon="fa-pencil-square-o" invisible="invoice_count == 0">
                                <field name="invoice_count" widget="statinfo" string="Invoices"/>
                            </button>
                        </div>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <group>
                            <group>

                                <field name="customer_id" readonly="status == 'cancel'"/>
                                <field name="phone"/>
                                <field name="vehicle_id" readonly="status == 'cancel'" options="{'no_create': True, 'no_create_edit': True}" />
                                <field name="mechanic_ids" widget="many2many_tags" readonly="status == 'cancel'" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="job_type_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="bay_id" readonly="status == 'cancel'" invisible="status == 'occupied'"
                                       domain="[('job_type_ids', 'in', [job_type_id]),('status','==','free')]" options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>
                            <group>
                                <field name="job_date" readonly="status == 'cancel'"/>
                                <field name="total" widget="monetary" readonly="status == 'cancel'"/>
                                <field name="warranty" readonly="status == 'cancel'"/>
                                <field name="collected" readonly="status == 'cancel'"/>
                                <field name="company_id" readonly="status == 'cancel'"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Job Order Lines">
                                <field name="order_line_ids">
                                    <list editable="bottom">
                                        <field name="product_id" string="Product"/>
                                        <field name="product_qty"/>
                                        <field name="price_unit"/>
                                        <field name="sub_total"/>
                                    </list>

                                </field>
                            </page>

                            <page string="Repair Instructions">
                                <field name="repair_instructions" placeholder="Add Repair Instructions here..."/>
                            </page>
                            <page string="Customer Notes">
                                <field name="customer_note" placeholder="Add customer notes..."/>
                            </page>

                            <page string="Media" colspan="2" name="product_template_images">
                                <field colspan="2" name="vehicle_image_ids"
                                       class="o_website_sale_image_list" context="{'default_name': name}"
                                       mode="kanban" add-label="Add Media"
                                       nolabel="1" widget="x2_many_media_viewer"
                                       options="{'convert_to_webp': True}"/>
                            </page>

                             <page string="Appointment">
                                 <field name="appointment_ids"/>
                            </page>


                        </notebook>

                        <div class="oe_chatter">
                            <chatter/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

          <record id="workshop_job_order_view_graph" model="ir.ui.view">
        <field name="name">workshop.job.order.graph</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <graph string="Job Order Analysis" sample="1">
                <field name="customer_id"/>
                <field name="total" type="measure"/>
            </graph>
        </field>
    </record>

            <record id="workshop_job_order_view_pivot" model="ir.ui.view">
        <field name="name">workshop.job.order.pivot</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <pivot string="Job Orders Analysis" sample="1">
                <field name="job_date" type="row"/>
                <field name="total" type="measure"/>
            </pivot>
        </field>
    </record>

        <record id="workshop_job_order_view_activity" model="ir.ui.view">
            <field name="name">workshop.job.order.activity</field>
            <field name="model">workshop.job.order</field>
            <field name="arch" type="xml">
                <activity string="Activity Tests">
            <templates>
                <div t-name="activity-box">
                    <div>
                        <field name="name"/>
                    </div>
                </div>
            </templates>
        </activity>
    </field>
</record>

        <record id="view_workshop_job_order_filter" model="ir.ui.view">
            <field name="name">workshop.job.order.select</field>
            <field name="model">workshop.job.order</field>
            <field name="arch" type="xml">
            <search string="Search Job Orders">
<!--                <filter string="New" domain="[('status', '=', 'draft')]" name="filter_draft" />-->
                <filter string="Confirmed" domain="[('status', '=', 'confirmed')]" name="filter_confirmed" />
                <filter string="In Progress" name="filter_under_repair" domain="[('status', '=', 'in_progress')]"/>
                <filter string="Done" name="filter_done" domain="[('status', '=', 'done')]"/>
                <filter string="Invoiced" name="filter_cancel" domain="[('status', '=', 'invoiced')]"/>
                <filter string="Cancelled" name="returned" domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <group name="groupby">
                    <filter string="Mechanics" name="group_by_mechanic" domain="[]" context="{'group_by': 'mechanic_ids'}"/>
                    <filter string="Status" name="group_by_status" domain="[]" context="{'group_by': 'status'}"/>
                    <filter string="Order Date" name="group_by_date" context="{'group_by':'job_date'}"/>
                </group>
            </search>
        </field>
    </record>


        <record id="workshop_job_order_action" model="ir.actions.act_window">
            <field name="name">Job Order</field>
            <field name="res_model">workshop.job.order</field>
            <field name="view_mode">list,form,graph,pivot,activity</field>
            <field name="search_view_id" ref="view_workshop_job_order_filter"/>
            <field name="view_id" ref="workshop_job_order_view_list"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click here to create your first Vehicle.
                </p>
            </field>
        </record>
    </data>
</odoo>





