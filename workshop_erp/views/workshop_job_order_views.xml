<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="workshop_job_order_view_list" model="ir.ui.view">
            <field name="name">workshop.job.order.view.list</field>
            <field name="model">workshop.job.order</field>
            <field name="arch" type="xml">
                <list string="Job Order">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="vehicle_id"/>
                    <field name="mechanic_ids"/>
                    <field name="bay_id"/>
                    <field name="customer_note" optional="hide"/>
                    <field name="total" widget="monetary"/>
                    <field name="status" widget="badge"/>
                </list>
            </field>
        </record>


        <record id="workshop_job_order_view_form" model="ir.ui.view">
            <field name="name">workshop.job.order.view.form</field>
            <field name="model">workshop.job.order</field>
            <field name="arch" type="xml">
                <form string="Job Order">

                    <header>
                        <field name="status" widget="statusbar"
                               statusbar_visible="draft,confirmed,in_progress,done,invoiced"/>
                        <button name="action_confirm" string="Confirm" class="oe_highlight" type="object"
                                invisible="status != 'draft'"/>
                        <button name="action_start" string="Start" class="oe_highlight" type="object"
                                invisible="status != 'confirmed'"/>
                        <button name="action_done" string="Done" class="oe_highlight" type="object"
                                invisible="status != 'in_progress'"/>
                        <button name="action_invoiced" string="Create Invoice" class="oe_highlight" type="object"
                                invisible="status !='done'"/>
                        <button name="action_cancel" string="Cancel" class="oe_highlight" type="object"
                                invisible="status !='draft'"/>
                    </header>

                    <sheet>
                        <div class="oe-title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="customer_id" readonly="status == 'cancel'"/>
                                <field name="phone"/>
                                <field name="vehicle_id" readonly="status == 'cancel'"/>
                                <field name="mechanic_ids" widget="many2many_tags" readonly="status == 'cancel'"/>
                                <field name="bay_id" readonly="status == 'cancel'" invisible="status == 'occupied'"
                                       domain="[('status', '=', 'free')]"/>
                                <field name="warranty" readonly="status == 'cancel'"/>
                            </group>
                            <group>
                                <field name="job_date" readonly="status == 'cancel'"/>
                                <field name="total" widget="monetary" readonly="status == 'cancel'"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Job Order Lines">
                                <field name="order_line">
                                    <list editable="bottom">
                                        <field name="product_id" string="Product"/>
                                        <field name="product_qty"/>
                                        <field name="price_unit"/>
                                        <field name="sub_total"/>
                                    </list>

                                </field>
                            </page>

                            <page string="Repair Instructions">
                                <group>
                                    <field name="repair_instructions" placeholder="Add Repair Instructions here..."/>
                                </group>
                            </page>
                            <page string="Customer Notes">
                                <group>
                                    <field name="customer_note"/>
                                </group>
                            </page>
                            <page string="Media">
                                <field name="image" widget="image"/>
                            </page>
                        </notebook>


                        <div class="oe_chatter">
                            <chatter/>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="workshop_job_order_action" model="ir.actions.act_window">
            <field name="name">Job Order</field>
            <field name="res_model">workshop.job.order</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click here to create your first Vehicle.
                </p>
            </field>
        </record>
    </data>
</odoo>