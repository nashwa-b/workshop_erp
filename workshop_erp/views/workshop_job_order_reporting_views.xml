<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
          <record id="workshop_job_order_reporting_view_graph" model="ir.ui.view">
        <field name="name">workshop.job.order.graph</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <graph string="Job Order Analysis" sample="1">
                <field name="customer_id"/>
                <field name="total" type="measure"/>
            </graph>
        </field>
    </record>

            <record id="workshop_job_order_reporting_view_pivot" model="ir.ui.view">
        <field name="name">workshop.job.order.pivot</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <pivot string="Job Orders Analysis" sample="1">
                <field name="job_date" type="row"/>
                <field name="total" type="measure"/>
            </pivot>
        </field>
    </record>


        <record id="view_workshop_job_order_reporting_filter" model="ir.ui.view">
        <field name="name">workshop.job.order.select</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <search string="Search Job Orders">
                <filter string="New" domain="[('status', '=', 'draft')]" name="filter_draft" />
                <filter string="Confirmed" domain="[('status', '=', 'confirmed')]" name="filter_confirmed" />
                <filter string="In Progress" name="filter_under_repair" domain="[('status', '=', 'in_progress')]"/>
                <filter string="Done" name="filter_done" domain="[('status', '=', 'done')]"/>
                <filter string="Invoiced" name="filter_cancel" domain="[('status', '=', 'invoiced')]"/>
                <filter string="Cancelled" name="returned" domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <group name="groupby">
                    <filter string="Mechanics" name="group_by_mechanic" domain="[]" context="{'group_by': 'mechanic_ids'}"/>
                    <filter string="Status" name="group_by_status" domain="[]" context="{'group_by': 'status'}"/>
                    <filter string="Order Date" name="group_by_date" context="{'group_by':'job_date'}"/>
                </group>
            </search>
        </field>
    </record>

          <record id="workshop_job_order_reporting_action" model="ir.actions.act_window">
            <field name="name">Job Order Analysis</field>
            <field name="res_model">workshop.job.order</field>
            <field name="view_mode">list,form,graph,pivot</field>
                <field name="search_view_id" ref="view_workshop_job_order_reporting_filter"/>
                <field name="context">{'search_default_filter_draft': 1}</field>
               <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click here to create your first Vehicle.
                </p>
            </field>
        </record>
    </data>
</odoo>

