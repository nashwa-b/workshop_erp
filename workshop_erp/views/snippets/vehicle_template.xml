<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <template id="top_vehicle_template_highlight" name="Top Vehicles">
       <section class="vehicle_section">
           <div class="container">
               <div class="alert alert-info">
                   <h4>Top Workshop Vehicles</h4>
               </div>
           </div>
       </section>
   </template>
   <template id="category_highlight_snippet" inherit_id="website.snippets"
             name="Top Vehicles Snippet">
       <xpath expr="//snippets[@id='snippet_groups']" position="inside">
           <t t-snippet="workshop_erp.top_vehicle_template_highlight"/>
       </xpath>
       <xpath expr="//snippets[@id='snippet_structure']" position="inside">
           <t t-snippet="workshop_erp.top_vehicle_template_highlight"/>
       </xpath>
   </template>
</odoo>