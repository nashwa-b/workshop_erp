<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_form_inherit_vehicle_id" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.vehicle.id</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Vehicles">
                    <field name="vehicle_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="licence_plate"/>
                            <field name="vin"/>
                            <field name="odometer"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_vehicle"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck">
                    <field name="vehicle_count" widget="statinfo" string="Vehicles"/>
                </button>
                <button name="action_view_job_order"
                        type="object"
                        class="oe_stat_button">
                    <field name="job_order_count" widget="statinfo" string="Job Orders"/>
                </button>
            </xpath>
        </field>
    </record>
         <record id="res_partner_action" model="ir.actions.act_window">
            <field name="name">Customer</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Click here to create your first Job Type.
                </p>
            </field>
        </record>
</odoo>

