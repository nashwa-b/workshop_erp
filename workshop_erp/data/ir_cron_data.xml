<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_send_reminder_one_day_before" model="ir.cron">
            <field name="name">Reminder to customers one day before their scheduled appointment</field>
            <field name="model_id" ref="model_calendar_event"/>
            <field name="state">code</field>
            <field name="code">model._send_remainder()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 09:00:00')" />
            <field name="priority">4</field>
            <field name="active">True</field>
        </record>

         <record id="cron_send_daily_reminder" model="ir.cron">
            <field name="name">Daily reminder to customers to pick up their vehicle</field>
            <field name="model_id" ref="model_workshop_job_order"/>
            <field name="state">code</field>
            <field name="code">model._send_daily_remainder()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 09:00:00')" />
            <field name="priority">5</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>