<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        Email Template to send Purchase Order email to the Vendor
        <record id="mail_template_job_order_done" model="mail.template">
            <field name="name">Job Order Done</field>
            <field name="model_id" ref="workshop_erp.model_workshop_job_order"/>
            <field name="subject">Your Job order {{ object.name }} is Done</field>
            <field name="email_from">{{ object.activity_user_id.email }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="description">Sent to customers on job order completion</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                <p>Dear
                    <strong>
                        <t t-out="object.customer_id.name"/>
                    </strong>,
                </p>
                <p>
                    Your Job Order
                    <strong>
                        <t t-out="object.name"/>
                    </strong>
                    is done
                </p>
                     <p>Thankyou,</p>
                <p>
                    <strong>
                        <t t-out="object.company_id.name"/>
                    </strong>
                </p>
                </div>
            </field>
        </record>

        <record id="mail_template_calendar_event" model="mail.template">
            <field name="name">Appointment remainder</field>
            <field name="model_id" ref="workshop_erp.model_calendar_event"/>
            <field name="subject">Bring your car in for service</field>
            <field name="email_from">{{ object.user_id.email }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="description">Sent to customers one day before their appointment</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                     <p>Dear
                    <strong>
                        <t t-out="object.job_order_id.customer_id.name"/>
                    </strong>,
                </p>
                    <p>
                   Your vehicle service appointment is tomorrow. Bring your car in for service
                </p>
                     <p>Thankyou,</p>
                <p>
                    <strong>
                        <t t-out="object.user_id.name"/>
                    </strong>
                </p>

                </div>
            </field>
        </record>

         <record id="mail_template_vehicle_pickup" model="mail.template">
            <field name="name">Vehicle pickup remainder</field>
            <field name="model_id" ref="workshop_erp.model_workshop_job_order"/>
            <field name="subject">Your vehicle is ready for pick up</field>
            <field name="email_from">{{ object.activity_user_id.email }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="description">Sent to customers when vehicle is not picked up</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                     <p>Dear
                    <strong>
                        <t t-out="object.customer_id.name"/>
                    </strong>,
                </p>
                <p>
                    Your vehicle is ready to pickup
                </p>
                     <p>Thankyou,</p>
                <p>
                    <strong>
                        <t t-out="object.company_id.name"/>
                    </strong>
                </p>
                </div>
            </field>
        </record>

         <record id="mail_template_appointment_confirmation" model="mail.template">
            <field name="name">Send Appointment confirmation</field>
            <field name="model_id" ref="workshop_erp.model_calendar_event"/>
            <field name="subject">Appointment Confirmation</field>
            <field name="email_from">{{ object.user_id.email }}</field>
            <field name="use_default_to" eval="False"/>
            <field name="description">Sent to customers when appointment confirmed</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                     <p>Dear
                    <strong>
                        <t t-out="object.job_order_id.customer_id.name"/>
                    </strong>,
                </p>
                    <p>
                   Your Appointment for vehicle service is confirmed
                </p>
                     <p>Thankyou,</p>
                <p>
                    <strong>
                        <t t-out="object.user_id.name"/>
                    </strong>
                </p>
                </div>
            </field>
        </record>

    </data>
</odoo>
