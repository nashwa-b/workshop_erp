<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="payment_provider_form_multisafepay" model="ir.ui.view">
        <field name="name">payment.provider.form.inherit.multisafepay</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <field
                    name="multisafepay_api_key"
                    string = "API Key"
                    password="True"
                    invisible="code != 'multisafepay'"
                    widget="password"
                />
            </xpath>
        </field>
    </record>
</odoo>