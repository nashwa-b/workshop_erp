<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <record id="payment_provider_multisafepay" model="payment.provider">
        <field name="code">multisafepay</field>
        <field name="name">MultiSafepay</field>
        <field name="redirect_form_view_id" ref="multisafepay_form" />
        <field
            name="image_128"
            type="base64"
            file="payment_multisafepay/static/description/icon.png"
        />
        <field name="module_id" ref="base.module_payment_multisafepay" />

        <field name="support_refund">partial</field>
        <field name="allow_tokenization" eval="False" />
        <field name="capture_manually" eval="False" />
        <field name="allow_express_checkout" eval="False" />
         <field name="payment_method_ids"
               eval="[Command.set([
                         ref('payment.payment_method_card'),
                         ref('payment.payment_method_mada'),
                         ref('payment.payment_method_knet'),
                         ref('payment.payment_method_meeza'),
                         ref('payment.payment_method_naps'),
                         ref('payment.payment_method_omannet'),
                         ref('payment.payment_method_benefit'),
                   ])]"
        />
    </record>
</odoo>
