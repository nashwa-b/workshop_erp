<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_project_inherit" model="ir.ui.view">
        <field name="name">sale.order.view.form.project.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="project_id" invisible = "1"/>
                <button name="action_create_project_sale"
                        string="Create Project"
                        type="object"
                        class="btn-primary" invisible="project_id" />
                 <button name="action_update_project"
                        string="Update Project"
                        type="object"
                        class="btn-primary" invisible="not project_id"/>
            </xpath>
        </field>
    </record>
</odoo>