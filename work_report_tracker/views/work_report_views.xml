<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="work_report_view_list" model="ir.ui.view">
            <field name="name">work.report.view.list</field>
            <field name="model">work.report</field>
            <field name="arch" type="xml">
                <list string="Daily Work Report">
                    <field name="employee_id" string="Employee"/>
                     <field name="email_from" string="mail"/>
                    <field name="subject" string="Subject"/>
                     <field name="date"/>

                </list>
            </field>
        </record>

          <record id="work_report_view_form" model="ir.ui.view">
            <field name="name">work.report.view.form</field>
            <field name="model">work.report</field>
            <field name="arch" type="xml">
                <form string="Daily Work Report" editable="bottom">
                    <sheet>
                    <group>
                        <group>
                    <field name="employee_id" string="Employee"/>
                                                        <field name="email_from" string="Email"/>

                    <field name="subject" string="Subject"/>

                        </group>
                        <group>
                            <field name="date"/>
                        </group>
                         <notebook id="report_page_id">
                                <page string="Work Report">
   <field name="body"/>
                                </page>
                         </notebook>

                        <div class="oe_chatter">
                            <chatter/>
                        </div>

                    </group>
                    </sheet>

                </form>
            </field>
          </record>


          <record id="work_report_view_filter" model="ir.ui.view">
            <field name="name">work.report.view.select</field>
            <field name="model">work.report</field>
            <field name="arch" type="xml">
                <search string="Search Work Report">

                    <group name="groupby">
                        <filter string="Employee" name="group_by_employee" domain="[]"
                                context="{'group_by': 'employee_id'}"/>
                        <filter string="Report Date" name="group_by_date" context="{'group_by':'date'}"/>
                    </group>
                </search>
            </field>
        </record>

           <record id="work_report_view_graph" model="ir.ui.view">
            <field name="name">work.report.view.graph</field>
            <field name="model">work.report</field>
            <field name="arch" type="xml">
                <graph string="Work Report Analysis" sample="1">
                    <field name="employee_id"/>
                    <field name="date"/>
                </graph>
            </field>
        </record>


        <record id="work_report_view_pivot" model="ir.ui.view">
            <field name="name">work.report.view.pivot</field>
            <field name="model">work.report</field>
            <field name="arch" type="xml">
                <pivot string="Work Report Analysis" sample="1">
                    <field name="date" type="row"/>
                    <field name="employee_id"/>
                </pivot>
            </field>
        </record>

        <record id="work_report_action" model="ir.actions.act_window">
            <field name="name">Work Report</field>
            <field name="res_model">work.report</field>
            <field name="view_mode">list,form,graph,pivot</field>
              <field name="search_view_id" ref="work_report_view_filter"/>
        </record>

    </data>
</odoo>
