<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="report_work_report">
        <t t-call="web.external_layout">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.html_container">
                    <div class="page">
                        <center>
                            <h2>Work Report
                            </h2>
                        </center>
                        <div style="margin-top: 100px;">
                            <br>
                                <b t-if="wizard.employee_id">Employee:</b>
                            </br>
                            <span t-field="wizard.employee_id"/>
                            <br>
                                <b>Project:</b>
                                <span t-field="wizard.project_id"/>
                            </br>
                            <br>

                                <b>Start Date:</b>
                                <span t-field="wizard.start_date"/>
                            </br>
                            <br>
                                <b>End Date:</b>
                                <span t-field="wizard.end_date"/>
                            </br>

                        </div>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>
                                        <b>Sl No</b>
                                    </th>

                                    <th>
                                        <b>Date</b>
                                    </th>
                                    <th>
                                        <b>Project</b>
                                    </th>
                                    <th>
                                        <b>Tasks</b>
                                    </th>
                                    <th>
                                        <b>Remarks</b>
                                    </th>
                                </tr>
                            </thead>
                            <t t-foreach="data['report']" t-as="line">
                                <t t-set="work_report" t-value="env['work.report'].browse(line['work_report_id'])"/>
                                <t t-foreach="work_report.work_ids" t-as="work_line">
                                    <t t-if="work_line.project_id.name == wizard.project_id.name">
                                        <br></br>


                                        <tbody>
                                            <tr>
                                                <td>
                                                    <span t-esc="line_index + 1"/>
                                                </td>

                                                <td>
                                                    <span t-esc="line['date']"/>
                                                </td>
                                                <td>
                                                    <span t-esc="work_line.project_id.name"/>
                                                </td>
                                                 <td>
                                                    <span t-esc="work_line['task']"/>
                                                </td>
                                                <td>
                                                    <span t-esc="work_line['remarks']"/>
                                                </td>

                                            </tr>
                                        </tbody>
                                    </t>
                                </t>
                            </t>
                        </table>
                    </div>

                </t>
            </t>
        </t>

    </template>
</odoo>