<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
   <t t-name="weather_condition.WeatherCondition">
        <xpath expr="//div[hasclass('o_switch_company_menu d-none d-md-block')]" position="before">

            <Dropdown position="'bottom-end'" state="dropdown" bottomSheet="false">
                <button type="button">
        <t t-if="weather.enable_weather">
            <i class="fa fa-cloud"/>
        </t>
          </button>
                <t t-set-slot="content">
                    <div class="dropdown_styles" style="padding: 10px;margin-left:10px;margin-right:10px;">
                            <t t-if="weather.cod !=200">
                                <span style="color:red;margin-left:50px;margin-right:50px;">⚠️  City Not Found !</span>
            </t>
                        <t t-else="">
                            <t t-esc="weather.formatted_date"/>

                            <strong></strong>
                            <br></br>
                            <span>Day</span>
                            <t t-esc="weather.temp"/>
                            <strong>°</strong>
                            ⬆ ,
                            <span>Night</span>
                            <t t-esc="weather.temp"/>
                            <strong>° ⬇</strong>
                            <img class="img-fluid" width="80px" height
                                    ="80px"
                                 t-att-src
                                         ="weather.icon"
                                 alt="Card image cap" style=""/>
                            <br></br>

                            <div style="font-size:20px">
                                 <b>
                                                <t t-esc="weather.temp"/>
                                     <strong>°C  </strong>
                                     <t t-esc="weather.main"/></b> </div>
                            <br></br>
                            <div t-if="weather.location and weather.latitude == 0 or weather.longitude == 0">

                                <b><span>Location:</span></b>
                                <t t-esc="weather.location"/>
                    </div>
                            <div t-else="">
                <b><span>Latitude:</span></b>
                                <t t-esc="weather.latitude"/>
                                <br></br>
                                <b><span>Longitude:</span></b>
                                <t t-esc="weather.longitude"/>
                                <br></br>
                    </div>

                            <b> <span>last update:</span></b>
                            <br></br>

                            <t t-esc="weather.date"/>
                            <br></br>
                            <DropdownItem>
                                                                                                                                                                   </DropdownItem>

                        </t>
        </div>

                            </t>
                </Dropdown>
        </xpath>
   </t>
</templates>




