<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_weather" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.weather</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position='inside'>
                <div id="weather_settings">
                    <setting>
                        <field name="enable_weather" string="Weather"/>
      e              </setting>
                    <setting help="Mode" string="Mode" invisible="not enable_weather">
                        <field name="state" />
                    </setting>
                     <setting help="Location" string="Location" invisible="state != 'manual_location' or not enable_weather">
                        <field name="location" />
                    </setting>

                    <setting help="Latitude" string="Latitude" invisible="state!= 'fetch_location' or not enable_weather">
                        <field name="latitude" />
                    </setting>
                        <setting help="Longitude" string="Longitude" invisible="state != 'fetch_location' or not enable_weather">
                        <field name="longitude" />
                    </setting>
                    <setting help="OpenWeather API KEY"  string="API KEY" invisible="not enable_weather">
                        <field name="weather_api_keys"/>
                    </setting>
                    <setting invisible="state != 'fetch_location' or not enable_weather">
                                 <widget name="fetch_button"/>
                    </setting>
                </div>
            </xpath>
        </field>
    </record>
</odoo>