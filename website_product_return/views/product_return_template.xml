<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="product_return_template" inherit_id="sale.sale_order_portal_template" name="Return">
        <xpath expr="//div[hasclass('o_download_pdf')]"
               position="after">
            <!--                                    <form action="/returnformsubmit/%s'%sale_order.id" method="post">-->
            <form t-attf-action="/returnformsubmit/#{sale_order.id}" method="post">


