                                            <th>
                                                Product
                                            </th>
                                            <th>
                                                Quantity
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>


                                        <t t-foreach="sale_order.order_line" t-as="line">
<!--                                            <input type="hidden" name="sale_order_id" t-att-value="sale_order"/>-->

                                            <tr>
                                                <td>
                                                    <t t-esc="line.product_id.name"/>


                                                </td>
                                                <td>
                                                    <input id="quantity" name="quantity" type="number" value="0"
                                                           placeholder="Quantity" class="form-control quantity"/>
<!--                                                                                                <input type="hidden" name="quantity" t-att-value="quantity"/>-->

                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <!--                </div>-->
                            <!--                            <div>-->
                            <div class="modal-footer justify-content-between">
