<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_employee_transfer_wizard_form" model="ir.ui.view">
       <field name="name">employee.transfer.wizard.form</field>
       <field name="model">employee.transfer.wizard</field>
       <field name="arch" type="xml">
           <form string="Employee Transfer">
               <group>
<!--                   <field name="partner_id"/>-->
                   <field name="company_id"/>
<!--                   <field name="product_id" />-->
<!--                   <field name="quantity"/>-->
<!--                   <field name="price_unit"/>-->
               </group>
               <footer>
                   <button name="button_approve" string="Send Approval" class="oe_highlight" type="object"/>
<!--               <button name="action_close_sale_order_wizard" string="Cancel" class="oe_highlight" type="object" special="cancel"/>-->
               </footer>
           </form>
       </field>
   </record>

       <record id="employee_transfers_view_list_button" model="ir.ui.view">
            <field name="name">employee.transfers.view.list</field>
            <field name="model">employee.transfer.wizard</field>
            <field name="arch" type="xml">
                <list string="Approvals">
                    <field name="company_id"/>
                </list>
            </field>
        </record>

         <record id="employee_transfer_view_form_button" model="ir.ui.view">
            <field name="name">employee.transfer.view.list</field>
            <field name="model">employee.transfer.wizard</field>
            <field name="arch" type="xml">
                <form string="Approval">
                <header>
                         <button name="button_approve" string="Approve" class="oe_highlight" type="object"/>
                </header>
                    <sheet>
<!--                    <field name="name" ref="base.main_company"/>-->
                    <field name="company_id" string = "Company to Change" readonly="1"/>
                    </sheet>
                </form>

            </field>
        </record>
</odoo>