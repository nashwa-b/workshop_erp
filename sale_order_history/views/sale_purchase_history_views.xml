<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_purchase_history_view_list" model="ir.ui.view">
            <field name="name">sale.purchase.history.view.list</field>
            <field name="model">sale.purchase.history</field>
            <field name="arch" type="xml">
                <list string="History">
                    <field name="sale_id"/>
                    <field name="purchase_ids"/>
                    <field name="partner_id"/>
                    <field name="date"/>
                    <field name="salesperson_id"/>
                    <field name="vendor_ids"/>
                </list>
            </field>
        </record>

        <record id="sale_purchase_history_view_form" model="ir.ui.view">
            <field name="name">sale.purchase.history.view.form</field>
            <field name="model">sale.purchase.history</field>
            <field name="arch" type="xml">
                <list string="History" editable="bottom">
                     <field name="sale_id"/>
                    <field name="purchase_ids"/>
                    <field name="partner_id"/>
                    <field name="date"/>
                    <field name="salesperson_id"/>
                    <field name="vendor_ids"/>
                </list>
            </field>
        </record>

        <record id="sale_purchase_history_action" model="ir.actions.act_window">
            <field name="name">History</field>
            <field name="res_model">sale.purchase.history</field>
            <field name="view_mode">list,form</field>
<!--            <field name="help" type="html">-->
<!--                <p class="o_view_nocontent_smiling_face">-->
<!--                    Click here to create your first Job Type.-->
<!--                </p>-->
<!--            </field>-->
        </record>
           <menuitem id="sale_purchase_history_menu" name="History" parent="sale.menu_sale_config" sequence="11" action="sale_order_history.sale_purchase_history_action" groups="sales_team.group_sale_manager"/>

    </data>
</odoo>
